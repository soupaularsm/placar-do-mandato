[{"ano":2026,"casaSessao":"SF","codigoMateria":175624,"codigoSessao":586477,"codigoSessaoLegislativa":874,"codigoSessaoVotacao":7104,"dataApresentacao":"2026-08-31","dataSessao":"2026-09-01","descricaoVotacao":"Votação nominal do Projeto de Decreto Legislativo nº 995, de 2026.","ementa":"Escolhe o Senhor Rodrigo Otavio Soares Pacheco para o cargo de Ministro do Tribunal de Contas da União, nos termos do inciso II do § 2º do art. 73 da Constituição Federal, do inciso II do art. 105 da Lei nº 8.443, de 16 de julho de 1992, e do art. 2º do Decreto Legislativo nº 6, de 1993.","idProcesso":9101425,"identificacao":"PDL 995/2026","informeLegislativo":{"casaColegiado":"SF","casaEnteAdm":"SF","codigoColegiado":1998,"data":"2026-09-01","id":2311755,"idEnteAdm":13594,"idEvento":11377365,"nomeColegiado":"Plenário do Senado Federal","nomeEnteAdm":"Secretaria de Atas e Diários","numeroAutuacao":1,"siglaColegiado":"PLEN","siglaEnteAdm":"SEADI","texto":"(Sessão Deliberativa Ordinária, realizada em 01/09/2026) \nEncaminhado à publicação e aprovado o Requerimento nº 640, de 2026, subscrito por líderes partidários, de urgência para a matéria. \nProferido pelo Senador Renan Calheiros e encaminhado à publicação o Parecer nº 174, de 2026, de Plenário, favorável à escolha do Senador Rodrigo Pacheco. \nDiscussão encerrada. \nAprovado o Projeto, com o seguinte resultado: Sim 63, Não 4, Presidente 1, Total 68. \nEncaminhado à publicação o Parecer n° 175, de 2026 – PLEN/SF, da Comissão Diretora, oferecendo a redação final. \nEncerrada a discussão. \nAprovada a redação final. \nA matéria vai à Câmara dos Deputados. \n"},"numero":"995","numeroSessao":120,"resultadoVotacao":"A","sequencialSessao":1,"sequencialVotacao":4418,"sigla":"PDL","siglaTipoSessao":"DOR","totalVotosAbstencao":0,"totalVotosNao":4,"totalVotosSim":63,"votacaoSecreta":"S","votos":[{"codigoParlamentar":5672,"descricaoVotoParlamentar":null,"nomeParlamentar":"Alan Rick","sexoParlamentar":"M","siglaPartidoParlamentar":"REPUBLICANO